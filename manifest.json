{
  "manifest_version": 3,
  "name": "Eclipse",
  "version": "0.8.1",
  "minimum_chrome_version": "125",
  "description": "Set website language, locale, time zone and location with regional profiles. Interface available in 12 languages.",
  "permissions": [
    "storage",
    "debugger",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eclipse · Language & region",
    "default_icon": {
      "16": "icons/grey-16.png",
      "20": "icons/grey-20.png",
      "24": "icons/grey-24.png",
      "32": "icons/grey-32.png",
      "48": "icons/grey-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "short_name": "Eclipse",
  "homepage_url": "https://github.com/boklagvladimir-dev/eclipse"
}
